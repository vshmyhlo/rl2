+      .def("route_point_collides", [](Simulator& simulator,
+                                      const rl2::RoutePoint& point, double radius) {
+        return rl2::routePointCollides(point, radius, routeQuery(simulator));
+      }, "point"_a, "radius"_a)
+      .def("route_points_collide", [](Simulator& simulator,
+          py::array_t<float, py::array::c_style> points, double radius) {
+        if (points.ndim() != 2 || points.shape(1) != 3)
+          throw py::value_error("positions must have shape (N, 3)");
+        const auto input = points.unchecked<2>();
+        py::array_t<bool> result(points.shape(0));
+        auto output = result.mutable_unchecked<1>();
+        auto query = routeQuery(simulator);
+        for (py::ssize_t i = 0; i < points.shape(0); ++i) {
+          output(i) = rl2::routePointCollides(
+              {input(i, 0), input(i, 1), input(i, 2)}, radius, query);
+        }
+        return result;
+      }, "positions"_a.noconvert(), "radius"_a)
