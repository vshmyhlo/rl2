+auto routeQuery(Simulator& simulator) {
+  return [&simulator](const std::array<float, 3>& point, float radius) {
+    const auto hit = simulator.getClosestCollisionPoint(
+        vec3f(point[0], point[1], point[2]), radius, true, true);
+    return rl2::CollisionHit{{hit.hitPos[0], hit.hitPos[1], hit.hitPos[2]},
+                             hit.isOutBound};
+  };
+}
