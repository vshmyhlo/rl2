    },
    {
      "id": 9,
      "title": "SM and memory clocks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_SM_CLOCK",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        },
        {
          "expr": "DCGM_FI_DEV_MEM_CLOCK",
          "refId": "B",
