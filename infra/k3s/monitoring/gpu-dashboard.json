{
  "uid": "gpu-overview",
  "title": "A100 GPU and host monitoring",
  "description": "Live NVIDIA GPU, host CPU, and RAM telemetry. Refreshes every 15 seconds; up to seven days of history.",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": [
    "GPU",
    "NVIDIA",
    "CPU",
    "RAM"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "GPU utilization",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_GPU_UTIL)",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "title": "VRAM used",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_FB_USED * 1024 * 1024)",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "title": "GPU temperature",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_GPU_TEMP)",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "title": "Power draw",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_POWER_USAGE)",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 11,
      "title": "Host CPU utilization",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "description": "Non-idle CPU time averaged across all logical CPUs."
    },
    {
      "id": 12,
      "title": "Host RAM utilization",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "description": "Percentage of total RAM unavailable for new allocations."
    },
    {
      "id": 13,
      "title": "Host CPU usage history",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Non-idle CPU time averaged across all logical CPUs."
    },
    {
      "id": 14,
      "title": "Host RAM usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{job=\"node\"} - node_memory_MemAvailable_bytes{job=\"node\"}",
          "refId": "A",
          "legendFormat": "{{instance}} used"
        },
        {
          "expr": "node_memory_MemTotal_bytes{job=\"node\"}",
          "refId": "B",
          "legendFormat": "{{instance}} total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Used RAM is total minus available memory, excluding reclaimable cache."
    },
    {
      "id": 5,
      "title": "GPU and memory bandwidth utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_GPU_UTIL)",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        },
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_MEM_COPY_UTIL)",
          "refId": "B",
          "legendFormat": "Memory bandwidth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "VRAM usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_FB_USED * 1024 * 1024)",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        },
        {
          "expr": "max by (UUID, hostname, gpu, modelName) ((DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE) * 1024 * 1024)",
          "refId": "B",
          "legendFormat": "Total VRAM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "GPU and memory temperature",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_GPU_TEMP)",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        },
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_MEMORY_TEMP)",
          "refId": "B",
          "legendFormat": "Memory temperature"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Power history",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_POWER_USAGE)",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "SM and memory clocks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_SM_CLOCK)",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        },
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_MEM_CLOCK)",
          "refId": "B",
          "legendFormat": "Memory clock"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MHz",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Uncorrectable ECC errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gpu-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (UUID, hostname, gpu, modelName) (DCGM_FI_DEV_ECC_DBE_VOL_TOTAL)",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
