---
import 'katex/dist/katex.min.css';

interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}

const { frontmatter } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={frontmatter.description} />
    <title>{frontmatter.title}</title>
  </head>
  <body>
    <main>
      <article>
        <slot />
      </article>
    </main>
  </body>
</html>

<style is:global>
  html {
    color-scheme: light;
    color: #292b30;
    background: #faf9f6;
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.7;
  }

  body {
    margin: 0;
  }

  main {
    max-width: 42rem;
    margin-inline: auto;
    padding: clamp(2rem, 8vw, 6rem) 1.5rem;
    font-size: 1.125rem;
    overflow-wrap: break-word;
  }

  h1 {
    font-size: clamp(2.5rem, 8vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  h2 {
    margin-top: 2.5rem;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  figure {
    margin: 2rem 0;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  figcaption, .eyebrow, footer {
    color: #64656c;
    font: 0.85rem/1.6 system-ui, sans-serif;
  }

  figcaption {
    margin-top: 0.75rem;
  }

  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .image-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.5rem 0;
  }

  footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid #deded8;
  }
</style>
