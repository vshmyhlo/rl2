# NVIDIA CUDA 12 training preset for this project's JAX 0.11.x.
# Run from the repository root, before importing JAX:
#   uv run --extra cuda12 --env-file nvida.env rl2
# Or load into your shell: source ./nvida.env
# Starting point for benchmarking; gains depend on GPU and workload.
# References:
# https://docs.jax.dev/en/latest/gpu_performance_tips.html
# https://docs.jax.dev/en/latest/201/gpu-memory.html
# https://docs.jax.dev/en/latest/persistent_compilation_cache.html

# Require CUDA; fail visibly if the CUDA backend cannot initialize.
export JAX_PLATFORMS=cuda

# One training process per GPU. Lower this fraction for shared/display GPUs.
# Preallocation reduces allocation overhead and fragmentation.
# Use the current name; do not also set legacy XLA_PYTHON_CLIENT_MEM_FRACTION.
export XLA_PYTHON_CLIENT_PREALLOCATE=true
export XLA_CLIENT_MEM_FRACTION=0.90

# Reuse compiled programs across runs (runs/ is already ignored by Git).
# Relative to the working directory; use a private absolute path if preferred.
export JAX_COMPILATION_CACHE_DIR=./runs/.jax_cache
export JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=1

# Triton GEMM candidates, communication/computation overlap, CUDA graph replay,
# and autotuning with output checking. Initial compilation can take longer.
# This assignment replaces existing XLA_FLAGS. Recheck flags after JAX upgrades.
export XLA_FLAGS="--xla_gpu_triton_gemm_any=true --xla_gpu_enable_latency_hiding_scheduler=true --xla_gpu_enable_command_buffer=FUSION,CUSTOM_CALL --xla_gpu_autotune_level=4"

# Optional: select a GPU (otherwise preserve the launcher's device visibility).
# export CUDA_VISIBLE_DEVICES=0

# Optional on Ampere or newer: allow TF32 for float32 matmul/convolution.
# Trades precision for throughput; compare learning curves before keeping it.
# This does not convert model parameters or activations to bfloat16.
# export JAX_DEFAULT_MATMUL_PRECISION=tensorfloat32

# Optional for long runs: profile and recompile for improved scheduling.
# Adds warmup overhead and cannot collect alongside Nsight Systems profiling.
# export JAX_ENABLE_PGLE=true
# export JAX_PGLE_PROFILING_RUNS=3
