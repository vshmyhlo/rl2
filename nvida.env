# NVIDIA CUDA 12 transformer-training preset for this project's JAX 0.11.x.
# Run from the repository root, before importing JAX:
#   uv run --extra cuda12 --extra gdn2 --extra gdn2-triton --env-file nvida.env python -m rl2.train_grpo_reasoning --config configs/grpo_reasoning.yaml
# Or load into your shell: source ./nvida.env
# Baseline for dedicated GPUs; benchmark on your model and interconnect.
# The GRPO trainer above is currently single-device. For multi-process training,
# the program must call jax.distributed.initialize() before device access and
# implement model/data sharding. This file does not launch or assign ranks.
# References:
# https://github.com/NVIDIA/JAX-Toolbox/blob/main/docs/GPU_performance.md
# https://openxla.org/xla/effort_levels
# https://docs.jax.dev/en/latest/gpu_performance_tips.html
# https://docs.jax.dev/en/latest/persistent_compilation_cache.html
# https://docs.nvidia.com/deeplearning/nccl/user-guide/docs/env.html

# Require CUDA; fail visibly if the CUDA backend cannot initialize.
export JAX_PLATFORMS=cuda

# Each GPU should belong to one process; a process may own multiple GPUs.
# Preserve the launcher's CUDA_VISIBLE_DEVICES and local device assignments.
# Preallocation reduces fragmentation; leave 10% for CUDA/NCCL and other buffers.
# Lower this fraction for shared/display GPUs or large NCCL buffer requirements.
# Use the current name; do not also set legacy XLA_PYTHON_CLIENT_MEM_FRACTION.
export XLA_PYTHON_CLIENT_PREALLOCATE=true
export XLA_CLIENT_MEM_FRACTION=0.90

# Enable XLA's GPU optimization bundle: latency hiding, collective pipelining,
# and loop double buffering. Trades compilation time and memory for throughput.
export JAX_OPTIMIZATION_LEVEL=O1

# Reuse compiled programs across runs (runs/ is already ignored by Git).
# For multi-node jobs, replace this with an absolute path on a shared filesystem
# accessible to every rank: only global rank 0 writes the persistent JAX cache.
# Use a cache writable only by trusted users. The default is relative to cwd.
export JAX_COMPILATION_CACHE_DIR=./runs/.jax_cache
export JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=1
export JAX_PERSISTENT_CACHE_MIN_ENTRY_SIZE_BYTES=0
export JAX_PERSISTENT_CACHE_ENABLE_XLA_CACHES=xla_gpu_per_fusion_autotune_cache_dir

# Keep collective errors visible; use INFO temporarily to diagnose networking.
export NCCL_DEBUG=WARN

# Keep XLA's default GEMM selection, CUDA graphs, and checked autotuning.
# Existing XLA_FLAGS are preserved. Recheck any custom flags after JAX upgrades.
# Let NCCL select transports, algorithms, protocols, and NVLink support for the
# detected topology. Set NCCL_SOCKET_IFNAME / NCCL_IB_HCA in the cluster launcher
# only when required by that fabric; do not hard-code interfaces here.

# Optional hardware tuning (benchmark each separately):
# Hopper: CUDA_DEVICE_MAX_CONNECTIONS=1 can improve communication overlap.
# Leave it unset on Blackwell, where NVIDIA reports this setting is slower.
# export CUDA_DEVICE_MAX_CONNECTIONS=1
# Blackwell: try restricting CUDA graph capture to fusions and custom calls.
# Append this flag to your launcher's XLA_FLAGS if it already supplies flags.
# export XLA_FLAGS="--xla_gpu_enable_command_buffer=FUSION,CUSTOM_CALL"
# FSDP: tune all-gather/reduce-scatter combine thresholds to layer tensor sizes;
# tune all-reduce buckets to balance bandwidth and overlap. No universal size.

# Optional on Ampere or newer: allow TF32 for float32 matmul/convolution.
# Trades precision for throughput; compare learning curves before keeping it.
# This does not convert model parameters or activations to bfloat16.
# Prefer bfloat16 in the model config (already used by grpo_reasoning.yaml).
# export JAX_DEFAULT_MATMUL_PRECISION=tensorfloat32

# Optional for long runs: profile and recompile for improved scheduling.
# Adds warmup overhead and cannot collect alongside Nsight Systems profiling.
# export JAX_ENABLE_PGLE=true
# export JAX_PGLE_PROFILING_RUNS=3
